# git-lfs configuration for binary artifacts.
# Commit everything (including binaries) for reproducibility; binaries via LFS.

# Image assets — used by recipe ground-truth, agent input, eval reports
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
# SVGs are text-y; keep as text so diffs work
*.svg text

# Video
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# Fonts
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.eot filter=lfs diff=lfs merge=lfs -text

# Compiled bundles
*.wasm filter=lfs diff=lfs merge=lfs -text

# Force text + LF line endings on shell scripts and common code
*.sh text eol=lf
*.py text
*.js text
*.ts text
*.tsx text
*.jsx text
*.html text
# Canonical rendered eval reports are large; LFS-track them specifically.
eval/reports/*.html filter=lfs diff=lfs merge=lfs -text
*.css text
*.md text
*.json text
*.toml text
*.yaml text
*.yml text
